<?xml version="1.0" encoding="utf-8"?>
<!--
  NetRecon MSIX manifest.

  Identity values that MUST match Partner Center exactly when you switch
  to production signing:
    - Name      : "PradaFit.NetRecon"  (replace if Partner Center reserved a different identity)
    - Publisher : "CN=PradaFitDev"     (REPLACE with the exact CN shown on
                                        Partner Center > App identity > Package identity)
    - Version   : 2.0.4.0              (4-part required by MSIX; do not use 2.0.4)

  Local sideload uses CN=PradaFitDev. Store re-signs after submission so
  the publisher CN must equal the Partner Center value before you upload.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 rescap">

  <Identity
    Name="PradaFit.NetRecon"
    Publisher="CN=PradaFitDev"
    Version="2.0.4.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>NetRecon</DisplayName>
    <PublisherDisplayName>PradaFitDev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Network Reconnaissance Toolkit: DNS, IP geolocation, port scanning, traceroute mapping, WHOIS, and export.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="NetRecon"
      Executable="NetRecon.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="NetRecon"
        Description="Network Reconnaissance Toolkit"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="NetRecon"
          Wide310x150Logo="Assets\Wide310x150Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1A1A1A" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension
          Category="windows.appExecutionAlias"
          Executable="NetRecon-CLI.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="netrecon-cli.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust: required for any packaged Win32 desktop app
         (PyInstaller exe, subprocess to tracert.exe, file I/O outside container). -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Network access for DNS, geolocation APIs, public IP detection. -->
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>

</Package>
